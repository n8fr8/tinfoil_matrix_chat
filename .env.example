# ---- Matrix homeserver & identity ----
MATRIX_HOMESERVER_URL=https://matrix.org

# Option A (recommended): a long-lived access token.
# Get one with `npm run login`, or from your client's settings.
MATRIX_ACCESS_TOKEN=

# Option B: password login. If MATRIX_ACCESS_TOKEN is empty, the bot logs in
# with these and caches the resulting token in data/credentials.json.
MATRIX_USERNAME=@melongbot:matrix.org
MATRIX_PASSWORD=
MATRIX_DEVICE_NAME=melong-bot

# ---- Behaviour ----
# Auto-join rooms when invited.
MATRIX_AUTOJOIN=true
# End-to-end encryption support (works in encrypted rooms).
MATRIX_ENCRYPTION=true
# Leave empty to translate every text message. Set e.g. "!tr" to only translate
# messages that start with that prefix.
MATRIX_COMMAND_PREFIX=
# ERROR | WARN | INFO | DEBUG | TRACE
MATRIX_LOG_LEVEL=INFO

# ---- Local persistence ----
MATRIX_STORAGE_PATH=./data/bot.json
MATRIX_CRYPTO_PATH=./data/crypto
MATRIX_CREDENTIALS_PATH=./data/credentials.json

# ---- Melong Hugging Face inference endpoint ----
# Your dedicated HF Inference Endpoint base URL for TenzinGayche/Melong_preview.
# Use the inference base URL (the OpenAI route /v1/chat/completions is appended
# automatically in openai mode); don't include /v1/... yourself.
MELONG_ENDPOINT_URL=https://your-endpoint.endpoints.huggingface.cloud
# HF access token for the endpoint (also read from HF_TOKEN if set).
MELONG_API_TOKEN=
# Wire protocol the endpoint speaks. Run `npm run probe` to detect it.
#   openai -> POST <url>/v1/chat/completions  (TGI messages API / vLLM) [default]
#   hf     -> POST <url>                       ({inputs, parameters})
#   tgi    -> POST <url>/generate              (TGI raw text-generation)
MELONG_API_MODE=openai
# Model name sent in openai mode. vLLM requires it to match the served model;
# TGI ignores it (you can use "tgi").
MELONG_MODEL=TenzinGayche/Monlam_Melong_preview
MELONG_MAX_NEW_TOKENS=256
# Prompt sent to the model. {text} is replaced with the user's message.
MELONG_PROMPT_TEMPLATE=Please translate the following text into Tibetan: {text} Translation:
# For "hf" mode only: "messages" (chat array, default) or "text" (raw string).
MELONG_INPUT_MODE=messages
MELONG_TIMEOUT_MS=60000
