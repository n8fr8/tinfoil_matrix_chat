# ---- Matrix homeserver & identity ----
MATRIX_HOMESERVER_URL=https://matrix.org

# Option A (recommended): a long-lived access token.
# Get one with `npm run login`, or from your client's settings.
MATRIX_ACCESS_TOKEN=

# Option B: password login. If MATRIX_ACCESS_TOKEN is empty, the bot logs in
# with these and caches the resulting token in data/credentials.json.
MATRIX_USERNAME=@melongbot:matrix.org
MATRIX_PASSWORD=
MATRIX_DEVICE_NAME=melong-bot
# After a password login, delete this account's other devices with the same
# MATRIX_DEVICE_NAME (for hosts where storage doesn't survive restarts).
MATRIX_CLEANUP_OLD_DEVICES=false
# Serve a JSON status endpoint on this port. Leave empty to disable.
HEALTH_PORT=
# Name shown for the bot in rooms (set on startup). Leave empty to keep the current one.
MATRIX_DISPLAY_NAME=

# ---- Behaviour ----
# Auto-join rooms when invited.
MATRIX_AUTOJOIN=true
# End-to-end encryption support (works in encrypted rooms).
MATRIX_ENCRYPTION=true
# Private cross-signing keys for the bot account, written here by
# `npm run cross-signing`. The bot signs each new device with them, so clients
# keep sending it room keys after a restart. Keep secret.
MATRIX_CROSS_SIGNING_KEY=
# Leave empty to reply to every text message. Set e.g. "!ai" to only reply to
# messages that start with that prefix.
MATRIX_COMMAND_PREFIX=
# ERROR | WARN | INFO | DEBUG | TRACE
MATRIX_LOG_LEVEL=INFO

# ---- Local persistence ----
MATRIX_STORAGE_PATH=./data/bot.json
MATRIX_CRYPTO_PATH=./data/crypto
MATRIX_CREDENTIALS_PATH=./data/credentials.json

# ---- Chat via Tinfoil private inference ----
# Tinfoil API key (https://tinfoil.sh). The Tinfoil SDK reads this automatically.
TINFOIL_API_KEY=
# Model ID from https://docs.tinfoil.sh/models/overview
TINFOIL_MODEL=deepseek-v4-1-flash
# Optional: override the bot's personality / instructions.
CHAT_SYSTEM_PROMPT=
# How many past exchanges the bot remembers per room (0 = no memory).
CHAT_HISTORY_TURNS=10
# Reply length cap; includes any thinking tokens.
CHAT_MAX_NEW_TOKENS=16000
CHAT_TIMEOUT_MS=300000
# Let the model search the web when it needs current information
# (https://docs.tinfoil.sh/guides/web-search). Queries are sent from Tinfoil's
# enclave to Exa with personal data masked. Adds a per-request search fee.
WEB_SEARCH=true
# Topic guidance (prompts/*.md) picked per message; empty PROMPTS_DIR turns it off.
PROMPTS_DIR=./prompts
# Model that picks the topic (default: TINFOIL_MODEL).
PROMPT_CLASSIFIER_MODEL=

# ---- Attachments (images, audio, video, documents) ----
# Speech-to-text model for audio, voice messages and video soundtracks.
# Needs ffmpeg installed to convert formats other than MP3/WAV (e.g. voice notes).
TINFOIL_TRANSCRIPTION_MODEL=voxtral-small-24b
# Larger files are refused.
CHAT_MAX_ATTACHMENT_MB=25

# ---- Voice replies ----
# When someone asks for a spoken answer, the bot replies with a voice message.
# The voice must belong to the chosen model.
#   voxtral-tts (default, multilingual): neutral_female, neutral_male, casual_female,
#     casual_male, cheerful_female, ar_male, de_female, de_male, es_female, es_male,
#     fr_female, fr_male, hi_female, hi_male, it_female, it_male, nl_female, nl_male,
#     pt_female, pt_male
#   qwen3-tts (lower latency): aiden, dylan, eric, ono_anna, ryan, serena, sohee,
#     uncle_fu, vivian
TINFOIL_TTS_MODEL=voxtral-tts
TINFOIL_TTS_VOICE=neutral_female

# ---- Tibetan speech sidecar (optional) ----
# URL of the speech/ container (MMS Tibetan text-to-speech + speech-to-text).
# Locally: docker run -p 127.0.0.1:8000:8000 <speech image>, then http://127.0.0.1:8000
SPEECH_URL=
# Who transcribes voice notes when SPEECH_URL is set: auto (default; Tibetan
# speech -> sidecar, other languages -> SPEECH_DETECT_MODEL), tibetan (sidecar
# only) or general (TINFOIL_TRANSCRIPTION_MODEL only).
SPEECH_STT=auto
# "auto" uses Whisper's confidence to spot non-Tibetan speech.
SPEECH_DETECT_MODEL=whisper-large-v3-turbo
SPEECH_DETECT_THRESHOLD=-0.45
