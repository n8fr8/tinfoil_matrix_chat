{
  "name": "melong-matrix",
  "version": "0.1.0",
  "private": true,
  "description": "A general-purpose Matrix chatbot powered by Tinfoil private inference.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "login": "node --env-file-if-exists=.env src/login.js",
    "cross-signing": "node --env-file-if-exists=.env src/cross-signing-setup.js",
    "probe": "node --env-file-if-exists=.env src/probe.js",
    "c2pa-trust": "c2patool --settings c2pa-trust/c2pa.toml init trust --legacy",
    "test": "FILE_NOTE_WAIT_MS=300 node --test 'test/*.test.js'"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "marked": "^18.1.3",
    "matrix-bot-sdk": "^0.7.1",
    "sanitize-html": "^2.18.1",
    "tinfoil": "^1.2.2"
  }
}
